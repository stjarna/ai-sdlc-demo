{
  "name": "littlelist-crud-baseline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local, persistent personal task list. Independent pre-SDLC CRUD baseline.",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:browser",
    "check": "node scripts/check.mjs",
    "capture:before": "node scripts/capture-before.mjs",
    "verify:before": "node scripts/verify-before.mjs",
    "test:record": "node scripts/record-verification.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
